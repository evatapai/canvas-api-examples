# Copy this file to .env and fill in your own values. Never commit .env.
CANVAS_BASE_URL=https://your-school.instructure.com

# Only recipes that change data need this. Use a demo course, never a real one.
# CANVAS_COURSE_ID=
# Recipe 6 enrolls this demo user (not you) in that course and removes them again.
# CANVAS_ENROLL_USER_ID=

# Option A: a single access token. Simplest. Expires if you set an expiry date.
CANVAS_TOKEN=paste-your-access-token-here

# Option B: OAuth2 refresh. Fill in all three and the client gets a new access
# token whenever the old one expires. CANVAS_TOKEN becomes optional.
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=
# CANVAS_REFRESH_TOKEN=
